{
  "description": "Health needs no token; everything else answers 401 without the right one.",
  "steps": [
    {
      "request": { "method": "GET", "path": "/v1/health", "auth": false },
      "response": { "status": 200, "json": { "status": "ok", "epoch": "<epoch>", "maxWait": 60 } }
    },
    {
      "request": { "method": "GET", "path": "/v1/changes?since=0", "auth": false },
      "response": { "status": 401, "json": { "detail": "<any>" } }
    },
    {
      "request": { "method": "POST", "path": "/v1/push", "auth": false, "json": { "device": "mac-a", "records": [] } },
      "response": { "status": 401, "json": { "detail": "<any>" } }
    },
    {
      "request": { "method": "GET", "path": "/v1/changes?since=0" },
      "response": { "status": 200, "json": { "records": [], "cursor": 0, "more": false, "epoch": "<epoch>" } }
    }
  ]
}
